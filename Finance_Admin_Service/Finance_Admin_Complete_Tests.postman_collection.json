            }
          }
        },
        {
          "name": "Invalid Approval Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Invalid request returns 400', function () {",
                  "    pm.response.to.have.status(400);",
