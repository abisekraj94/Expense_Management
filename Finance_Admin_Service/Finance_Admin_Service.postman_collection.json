{
  "info": {
    "name": "Finance Admin Service API",
    "description": "Complete API collection for Finance Admin Service - Expense Approval Workflow",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8081/api/v1",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('jwt_token', response.accessToken);",
                  "    pm.test('Login successful', function () {",
                  "        pm.expect(response.accessToken).to.not.be.empty;",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticate admin user and get JWT token"
          }
        }
      ]
    },
    {
      "name": "Expense Management",
      "item": [
        {
          "name": "Get Pending Expenses",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/expenses/pending?page=0&size=10",
              "host": ["{{base_url}}"],
              "path": ["expenses", "pending"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            },
            "description": "Get all pending expenses with pagination"
          }
        },
        {
          "name": "Get Expense by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/expenses/1",
              "host": ["{{base_url}}"],
              "path": ["expenses", "1"]
            },
            "description": "Get specific expense details by ID"
          }
        },
        {
          "name": "Approve Expense",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expenseId\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/expenses/approve",
              "host": ["{{base_url}}"],
              "path": ["expenses", "approve"]
            },
            "description": "Approve a pending expense"
          }
        },
        {
          "name": "Reject Expense",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expenseId\": 3,\n  \"rejectionReason\": \"Receipt is not clear and expense category is not justified according to company policy\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/expenses/reject",
              "host": ["{{base_url}}"],
              "path": ["expenses", "reject"]
            },
            "description": "Reject a pending expense with reason"
          }
        },
        {
          "name": "Get Currency Totals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/expenses/totals/currency",
              "host": ["{{base_url}}"],
              "path": ["expenses", "totals", "currency"]
            },
            "description": "Get total approved amounts by currency"
          }
        },
        {
          "name": "Get Total Amount in INR",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/expenses/totals/inr",
              "host": ["{{base_url}}"],
              "path": ["expenses", "totals", "inr"]
            },
            "description": "Get total approved amount converted to INR"
          }
        },
        {
          "name": "Sync Expense from Employee Service",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/expenses/1/sync",
              "host": ["{{base_url}}"],
              "path": ["expenses", "1", "sync"]
            },
            "description": "Sync expense data from Employee Service"
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Generate Expense Report",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/reports/expenses?employeeIds=1,2,3&startDate=2024-01-01&endDate=2024-01-31&page=0&size=5",
              "host": ["{{base_url}}"],
              "path": ["reports", "expenses"],
              "query": [
                {
                  "key": "employeeIds",
                  "value": "1,2,3",
                  "description": "List of employee IDs (max 5)"
                },
                {
                  "key": "startDate",
                  "value": "2024-01-01",
                  "description": "Start date (YYYY-MM-DD)"
                },
                {
                  "key": "endDate",
                  "value": "2024-01-31",
                  "description": "End date (YYYY-MM-DD)"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "5"
                }
              ]
            },
            "description": "Generate expense report for multiple employees with date range filter"
          }
        },
        {
          "name": "Employee Specific Report",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/reports/expenses/employee/1?startDate=2024-01-01&endDate=2024-01-31",
              "host": ["{{base_url}}"],
              "path": ["reports", "expenses", "employee", "1"],
              "query": [
                {
                  "key": "startDate",
                  "value": "2024-01-01",
                  "description": "Start date (YYYY-MM-DD)"
                },
                {
                  "key": "endDate",
                  "value": "2024-01-31",
                  "description": "End date (YYYY-MM-DD)"
                }
              ]
            },
            "description": "Generate expense report for specific employee"
          }
        },
        {
          "name": "Report with Date Range Only",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/reports/expenses?startDate=2024-01-01&endDate=2024-01-31&page=0&size=5",
              "host": ["{{base_url}}"],
              "path": ["reports", "expenses"],
              "query": [
                {
                  "key": "startDate",
                  "value": "2024-01-01"
                },
                {
                  "key": "endDate",
                  "value": "2024-01-31"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "5"
                }
              ]
            },
            "description": "Generate expense report with date range filter only"
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Application Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/actuator/health",
              "host": ["{{base_url}}"],
              "path": ["actuator", "health"]
            },
            "description": "Check application health status"
          }
        },
        {
          "name": "Application Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/actuator/info",
              "host": ["{{base_url}}"],
              "path": ["actuator", "info"]
            },
            "description": "Get application information"
          }
        }
      ]
    }
  ]
}